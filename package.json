{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "cap:sync": "vite build && cap sync android",
    "cap:open": "cap open android",
    "android:build": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "vite build && cap sync android && cd android && ./gradlew assembleRelease",
    "export:android-zip": "node export-android-zip.js",
    "test": "tsx tests/verify-all.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@google/genai": "^3.6.1",
    "@mlc-ai/web-llm": "^0.2.89",
    "@types/express": "^5.0.6",
    "clsx": "2.1.1",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.78.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
